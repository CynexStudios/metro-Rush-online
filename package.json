{
  "name": "metro-rush-neon-city",
  "private": true,
  "version": "8.0.0",
  "description": "METRO RUSH: NEON CITY 8.0.0 — SKYLINE PROTOCOL: Videojuego 3D de parkour urbano, 10 metrópolis, vehículos terrestres y voladores, jefes con radar y drones de apoyo, tienda 3D/2D y multijugador LAN/Internet.",
  "author": "Jaderson Liriano (XynexDevs)",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "generate:manifest": "node scripts/generate-release-manifest.mjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release",
    "lint": "tsc --noEmit"
  },
